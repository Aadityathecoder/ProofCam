{
  "name": "ProofCam",
  "short_name": "ProofCam",
  "description": "Take photos that carry a signed proof inside the JPEG, and check whether a photo still matches its proof.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F7F9FB",
